# Copy this file to .env before starting the local Docker lab.
# Use unique values; do not commit the real .env file.
SQLI_LAB_FLAG=PNP{replace_with_a_local_sqli_flag}
IDOR_LAB_FLAG=PNP{replace_with_a_local_idor_flag}
TRAVERSAL_LAB_FLAG=PNP{replace_with_a_local_path_flag}
XSS_LAB_FLAG=PNP{replace_with_a_local_xss_flag}
SSRF_LAB_FLAG=PNP{replace_with_a_local_ssrf_flag}
AUTH_LAB_FLAG=PNP{replace_with_a_local_auth_flag}
UPLOAD_LAB_FLAG=PNP{replace_with_a_local_upload_flag}
NOSQL_LAB_FLAG=PNP{replace_with_a_local_nosql_flag}
PNP_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Browser-based personal labs (build hub/session.compose.yml images before starting).
PNP_MANAGED_LABS=true
PNP_MAX_SESSIONS=5
PNP_LAB_DOMAIN=labs.localhost
PNP_LAB_SCHEME=http
PNP_LAB_PORT=8000
PNP_COOKIE_SECURE=false
PNP_INGRESS_NETWORK=pnp-lab-ingress
